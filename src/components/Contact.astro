---
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import { profile, socials } from '../data/profile';
const year = new Date().getFullYear();
---
<section class="section" id="contact">
  <div class="shell">
    <SectionHead marker="05 //" title="Get in touch" />

    <div class="panel reveal">
      <div class="copy">
        <p class="lead">
          Building something interesting, hiring, or just want to compare notes?
          Mail lands fastest.
        </p>
        <a class="mailto mono" href={`mailto:${profile.email}`}>
          <Icon name="mail" size={18} />
          {profile.email}
        </a>
      </div>

      <ul class="links">
        {socials.filter((s) => s.icon !== 'mail').map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="me noopener">
              <Icon name={s.icon} size={17} />
              <span class="l">{s.label}</span>
              <span class="h mono">{s.handle}</span>
              <span class="arr"><Icon name="arrow" size={15} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<footer class="foot">
  <div class="shell foot-inner mono">
    <p>© {year} {profile.name}</p>
    <p class="built">
      Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>.
      No trackers, no cookies.
    </p>
    <a class="top" href="#top">back to top ↑</a>
  </div>
</footer>

<style>
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .lead {
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    color: var(--text);
    max-width: 30ch;
    line-height: 1.6;
  }

  .mailto {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.25rem;
    font-size: 0.95rem;
    color: var(--accent);
    word-break: break-all;
    transition: opacity 0.18s;
  }

  .mailto:hover { opacity: 0.75; }

  .links { display: grid; gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }

  .links a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.1rem;
    background: var(--bg);
    color: var(--text-dim);
    font-size: 0.9rem;
    transition: background-color 0.18s, color 0.18s;
  }

  .links a:hover { background: var(--surface-hi); color: var(--text); }

  .l { font-weight: 500; }
  .h { margin-left: auto; font-size: 0.78rem; color: var(--text-faint); }

  .arr { display: grid; opacity: 0; translate: -6px 0; transition: opacity 0.18s, translate 0.18s; color: var(--accent); }
  .links a:hover .arr { opacity: 1; translate: 0 0; }

  /* ---------- footer ---------- */

  .foot { border-top: 1px solid var(--border); padding-block: 1.75rem; }

  .foot-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    font-size: 0.78rem;
    color: var(--text-faint);
  }

  .built { margin-right: auto; }
  .built a { color: var(--text-dim); border-bottom: 1px solid var(--border-hi); }
  .built a:hover { color: var(--accent); border-color: var(--accent); }

  .top { transition: color 0.18s; }
  .top:hover { color: var(--accent); }

  @media (max-width: 760px) {
    .panel { grid-template-columns: 1fr; }
    .h { display: none; }
  }
</style>
